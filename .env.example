# PostgreSQL
POSTGRES_USER=artguardian
POSTGRES_PASSWORD=changeme
POSTGRES_DB=artguardian
POSTGRES_INITDB_ARGS=--locale=en_US.UTF-8 --encoding=UTF8

# PgBouncer
DATABASES_USER=artguardian
DATABASES_PASSWORD=changeme

# MinIO container credentials
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# MinIO client credentials (used by backend)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_SECURE=false
MINIO_BUCKET_NAME=artguardian
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000/artguardian

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@artguardian.dev
PGADMIN_DEFAULT_PASSWORD=changeme

# Backend / JWT
SECRET_KEY=changeme-min-32-chars-long-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://artguardian:changeme@pgbouncer:6432/artguardian

# CORS
CORS_ORIGINS=http://localhost:80,http://127.0.0.1:80

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=80
